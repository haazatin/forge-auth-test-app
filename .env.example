# Public host port used by Compose.
APP_PORT=8080
# Runtime HTTP configuration.
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080
# Exact email domain permitted to create and access accounts.
ALLOWED_EMAIL_DOMAIN=shapira.xyz
# SendGrid connection. Replace every placeholder through the platform's secret/config bindings.
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_API_BASE_URL=https://sendgrid-api.example.invalid
TRANSACTIONAL_EMAIL_FROM=auth@example.invalid
TRANSACTIONAL_EMAIL_FROM_NAME=Auth Lab
# PostgreSQL connection string (local-development default only).
DATABASE_URL=postgresql://auth_app:auth_app_local@localhost:5432/auth_app
# Replace with at least 32 random bytes in every non-local environment.
SESSION_SECRET=local-only-change-this-32-character-secret
